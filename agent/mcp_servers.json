{
  "servers": [
    {
      "name": "elastic",
      "command": "uv",
      "args": [
        "--directory",
        "/mnt/c/Users/user/Desktop/elasticsearch-mcp-server-2.0.17",
        "run",
        "elasticsearch-mcp-server"
      ],
      "env": {
        "ELASTICSEARCH_HOSTS": "https://localhost:9200",
        "ELASTICSEARCH_USERNAME": "elastic",
        "ELASTICSEARCH_PASSWORD": "test123",
        "ELASTICSEARCH_VERIFY_CERTS": "false"
      },
      "enabled": true
    },
    {
      "name": "velociraptor",
      "command": "/mnt/c/Users/user/Desktop/velociraptor/mcp-velociraptor/.venv/bin/python",
      "args": [
        "/mnt/c/Users/user/Desktop/velociraptor/mcp-velociraptor/mcp_velociraptor_bridge.py"
      ],
      "enabled": true
    },
    {
      "name": "sleuthkit",
      "command": "/mnt/c/Users/user/Desktop/sleuthkit-mcp-server/.venv/bin/python",
      "args": [
        "/mnt/c/Users/user/Desktop/sleuthkit-mcp-server/sleuthkit_mcp_server.py"
      ],
      "env": {
        "PATH": "/usr/bin:/usr/local/bin:/bin"
      },
      "enabled": true
    },
    {
      "name": "ghidra",
      "command": "sh",
      "args": [
        "-c",
        "cd $HOME && rm -rf pyghidra_mcp_projects && uvx pyghidra-mcp"
      ],
      "env": {
        "GHIDRA_INSTALL_DIR": "/mnt/c/Users/user/Desktop/ghidra_11.3.2_PUBLIC"
      },
      "enabled": true
    },
    {
      "name": "virustotal",
      "command": "npx",
      "args": ["@burtthecoder/mcp-virustotal"],
      "env": {
        "VIRUSTOTAL_API_KEY": "${VIRUSTOTAL_API_KEY}"
      },
      "enabled": true
    },
    {
      "name": "browser-db-parser",
